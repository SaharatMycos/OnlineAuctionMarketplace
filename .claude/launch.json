{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Marketplace.Api"],
      "port": 5080
    },
    {
      "name": "mockup",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": ["-NoProfile", "-File", "mockup/serve.ps1", "-Port", "5173"],
      "port": 5173
    }
  ]
}
