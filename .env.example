# Local secrets and settings. Copy to .env (git-ignored) with:  pwsh -File scripts/init-env.ps1
# The script fills the "change-me" values with random ones. Never commit .env.
#
# Read by:
#   - docker compose (automatically, for ${...} in docker-compose.yml)
#   - the .NET hosts and `dotnet ef` when run outside Docker (Marketplace.SharedKernel DotEnv.Load)
# Real environment variables always win over this file.
#
# Use letters and digits only: the values go inside connection strings.

# ---- Secrets -------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# HS256 key for dev JWTs: at least 32 characters.
AUTH_SIGNING_KEY=change-me

# ---- Database ------------------------------------------------------------------
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace

# ---- .NET hosts run with `dotnet run` (they reach Docker through localhost) -------
# Compose builds its own versions of these with the service names (postgres, redis).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
ConnectionStrings__Redis=localhost:6379,password=${REDIS_PASSWORD}
Auth__SigningKey=${AUTH_SIGNING_KEY}
