# Local secrets and settings. Copy to .env (git-ignored) with:  pwsh -File scripts/init-env.ps1
# The script fills the "change-me" values with random ones. Never commit .env.
#
# Read by docker compose (automatically, for ${...} in docker-compose.yml) and by the scripts.
# The .NET hosts don't read it: init-env.ps1 copies these values into each host's git-ignored
# appsettings.Development.json, which dotnet run / dotnet ef use.
#
# Use letters and digits only: the values go inside connection strings.

# ---- Secrets -------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# HS256 key for dev JWTs: at least 32 characters.
AUTH_SIGNING_KEY=change-me

# ---- Database ------------------------------------------------------------------
# Postgres runs outside Docker (with PostGIS installed): on this machine by default, or on any
# other server. The api creates the database and applies the EF Core migrations on startup, so
# this user must be allowed to create databases and the postgis extension (the postgres superuser
# is fine for local dev).
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PORT=5432
# Postgres host for dotnet run / dotnet ef (written into appsettings.Development.json by init-env.ps1).
POSTGRES_HOST=localhost
# Postgres host for the compose app containers. Inside a container "localhost" is the container
# itself, so this machine is host.docker.internal. For a Postgres on another server, set both
# POSTGRES_HOST and POSTGRES_HOST_FROM_DOCKER to that server's name or IP.
POSTGRES_HOST_FROM_DOCKER=host.docker.internal
